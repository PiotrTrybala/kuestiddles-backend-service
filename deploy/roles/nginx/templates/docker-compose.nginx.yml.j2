version: "3.9"

services:
  nginx:
    image: nginx:1.27-alpine
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - {{ nginx_conf_dir }}/nginx.conf:/etc/nginx/nginx.conf:ro
      - {{ certbot_webroot_dir }}:/var/www/certbot:ro
      - {{ letsencrypt_dir }}:/etc/letsencrypt:ro
    networks:
      - {{ docker_network }}
    deploy:
      replicas: {{ nginx_replicas }}
      placement:
        constraints:
          - node.role == manager
      update_config:
        parallelism: 1
        order: start-first
      restart_policy:
        condition: on-failure

networks:
  {{ docker_network }}:
    external: true
