version: "3.9"

services:
  caddy:
    image: caddy:2.7-alpine
    ports:
      - 80:80
      - 443:443
    volumes:
      - caddy_data:/data
      - caddy_config:/config
      - /etc/caddy/Caddyfile:/etc/caddy/Caddyfile
    networks:
      - {{ docker_network }}
    deploy:
      placement:
        constraints:
          - node.role == manager
      restart_policy:
        condition: on-failure

networks:
  {{ docker_network }}:
    external: true

volumes:
  caddy_data:
  caddy_config: